# ============================================================================
# FIREBASE CLIENT (public — safe to expose, used in the browser)
# Get these from: Firebase Console → Project Settings → General → Your apps → Web app
# ============================================================================
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ============================================================================
# FIREBASE ADMIN (SECRET — server only, never expose to the browser)
# Get these from: Firebase Console → Project Settings → Service accounts →
# Generate new private key (downloads a JSON file). Copy the three values below.
# IMPORTANT: keep the \n escapes in the private key on a single line.
# ============================================================================
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ============================================================================
# ANALYTICS — Looker Studio embed (optional)
# Set a Looker Studio "Embed report" URL (Share → Embed report) to switch
# from the native analytics module to a real Looker Studio iframe — zero
# code change, just a config change. Each role can have its own URL (for
# row-level security). If a role-specific URL is unset, falls back to the
# default. Leave all blank to use the native module.
# ============================================================================
NEXT_PUBLIC_LOOKER_EMBED_URL=            # default / fallback
NEXT_PUBLIC_LOOKER_EMBED_URL_ADMIN=      # admin-specific embed URL
NEXT_PUBLIC_LOOKER_EMBED_URL_ANALYST=    # analyst-specific embed URL
NEXT_PUBLIC_LOOKER_EMBED_URL_VIEWER=     # viewer-specific embed URL

# Session cookie name (optional override)
SESSION_COOKIE_NAME=__nbdsp_session
